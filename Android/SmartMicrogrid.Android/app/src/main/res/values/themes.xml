<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SmartMicrogrid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/smart_micro_splash</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/bg_light</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_dark_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/text_dark_primary</item>
        <item name="colorSecondaryContainer">@color/primary</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorTertiary">@color/neon_cyan</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        
        <!-- Customize colors for Day theme -->
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/glass_light</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="colorOutline">@color/surface_outline</item>
        <item name="colorSurfaceVariant">@color/surface_soft</item>
        <item name="android:fontFamily">sans</item>
        <item name="colorSurface">@color/glass_light</item>
        <item name="colorOnSurface">@color/text_light_primary</item>
        <item name="android:textColorPrimary">@color/text_light_primary</item>
        <item name="android:textColorSecondary">@color/text_light_secondary</item>
        
        <!-- Glass Card & Navigation Styles -->
        <item name="materialCardViewStyle">@style/Widget.SmartMicrogrid.CardView.Glass</item>
        <item name="materialButtonStyle">@style/Widget.SmartMicrogrid.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.SmartMicrogrid.BottomNavigationView</item>
    </style>

    <style name="Widget.SmartMicrogrid.CardView.Glass" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">@color/surface_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <style name="Widget.SmartMicrogrid.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
    </style>

    <style name="Widget.SmartMicrogrid.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_navigation</item>
        <item name="elevation">12dp</item>
        <item name="itemIconTint">@color/nav_item_tint_selector</item>
        <item name="itemTextColor">@color/nav_item_tint_selector</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.SmartMicrogrid.BottomNavigationView.ActiveIndicator</item>
        <item name="itemRippleColor">#1A2563EB</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">22dp</item>
    </style>

    <style name="Widget.SmartMicrogrid.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#1A2563EB</item>
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
    </style>
</resources>
