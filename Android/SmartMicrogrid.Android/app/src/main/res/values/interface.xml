<resources>
    <dimen name="screen_gutter">20dp</dimen>
    <dimen name="surface_corner">18dp</dimen>
    <dimen name="screen_title_size">24sp</dimen>
    <dimen name="navigation_height">76dp</dimen>

    <style name="TextAppearance.SmartMicrogrid.Navigation" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.SmartMicrogrid.Navigation.Active" parent="TextAppearance.SmartMicrogrid.Navigation">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.SmartMicrogrid.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>
    <style name="Widget.SmartMicrogrid.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.SmartMicrogrid.Toolbar</item>
        <item name="titleTextColor">?android:attr/textColorPrimary</item>
        <item name="navigationIconTint">?android:attr/textColorPrimary</item>
    </style>
    <style name="TextAppearance.SmartMicrogrid.Toolbar" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Animation.SmartMicrogrid" parent="android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/surface_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>
</resources>
