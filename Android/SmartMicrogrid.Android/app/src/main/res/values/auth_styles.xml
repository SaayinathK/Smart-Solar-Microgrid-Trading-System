<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.SmartMicrogrid.Auth.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/auth_input</item>
        <item name="boxStrokeColor">@color/auth_outline</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/auth_muted</item>
        <item name="android:textColorHint">@color/auth_muted</item>
        <item name="endIconTint">@color/auth_muted</item>
        <item name="helperTextTextColor">@color/auth_muted</item>
    </style>
    <style name="Widget.SmartMicrogrid.Auth.Link" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/auth_link</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.SmartMicrogrid.Auth.PhotoControl" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="backgroundTint">#CC102338</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="cornerRadius">24dp</item>
    </style>
</resources>
