<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SmartMicrogrid" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_dark_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/text_dark_primary</item>
        <item name="colorSecondaryContainer">@color/primary</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        
        <!-- Customize colors for Night theme -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/glass_dark</item>
        <item name="colorOnSurface">@color/text_dark_primary</item>
        <item name="android:textColorPrimary">@color/text_dark_primary</item>
        <item name="android:textColorSecondary">@color/text_dark_secondary</item>
        
        <!-- Glass Card Style -->
        <item name="materialCardViewStyle">@style/Widget.SmartMicrogrid.CardView.Glass</item>
        <item name="materialButtonStyle">@style/Widget.SmartMicrogrid.Button</item>
    </style>

    <style name="Widget.SmartMicrogrid.CardView.Glass" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">@color/card_stroke_dark</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>
</resources>
