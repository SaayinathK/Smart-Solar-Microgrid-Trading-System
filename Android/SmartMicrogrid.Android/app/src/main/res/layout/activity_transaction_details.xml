<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:id="@+id/details_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transaction_details"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:checkable="false"
                    android:clickable="false"
                    android:text="Pending"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="@color/m3_status_success_background" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/transaction_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="?android:attr/colorBackground"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Transaction progress"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView android:id="@+id/tv_timeline_created" style="@style/TransactionDetailValue" android:layout_marginTop="6dp" android:text="1  ✓  Created" />
                        <TextView android:id="@+id/tv_timeline_qr" style="@style/TransactionDetailValue" android:text="2  ○  QR Generated" />
                        <TextView android:id="@+id/tv_timeline_verified" style="@style/TransactionDetailValue" android:text="3  ○  Verified" />
                        <TextView android:id="@+id/tv_timeline_transfer" style="@style/TransactionDetailValue" android:text="4  ○  Energy Transfer" />
                        <TextView android:id="@+id/tv_timeline_completed" style="@style/TransactionDetailValue" android:text="5  ○  Completed" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Transaction" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/verification_success_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/m3_success"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_verification_success_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Verification successful"
                            android:text="✓"
                            android:textColor="@color/m3_success"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/transaction_verified"
                            android:textColor="@color/m3_success"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="QR successfully matched this transaction."
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Transaction Code" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_transaction_code"
                    style="@style/TransactionDetailValue"
                    android:layout_marginTop="16dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Reservation ID" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_reservation_id"
                    style="@style/TransactionDetailValue" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Energy and participants" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Prosumer" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_prosumer_id"
                    style="@style/TransactionDetailValue" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Microgrid Node ID" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_microgrid_node_id"
                    style="@style/TransactionDetailValue" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Energy Slot ID" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_energy_slot_id"
                    style="@style/TransactionDetailValue" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Energy Amount" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_energy_amount"
                    style="@style/TransactionDetailValue" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Status" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_status"
                    style="@style/TransactionDetailValue"
                    android:textColor="@color/m3_success" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/generate_qr"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_qr"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/qr_generation_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_qr_generation_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/m3_error"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Activity times" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_created_at"
                    style="@style/TransactionDetailValue" />

                <TextView
                    android:id="@+id/tv_updated_at"
                    style="@style/TransactionDetailValue" />

                <TextView
                    android:id="@+id/tv_verification_time"
                    style="@style/TransactionDetailValue" />

                <TextView
                    android:id="@+id/tv_energy_transfer_time"
                    style="@style/TransactionDetailValue" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirm_energy_transfer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/continue_to_energy_transfer"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/scan_transaction_qr" />

                <TextView
                    android:id="@+id/tv_scan_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_verification_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/verification_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_verify_transaction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/verify_transaction" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel_verification"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cancel" />

                    <ProgressBar
                        android:id="@+id/verification_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
