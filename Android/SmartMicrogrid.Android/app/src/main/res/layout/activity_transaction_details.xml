<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:id="@+id/details_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ── Page title ── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transaction_details"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- ── Status chip ── -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:checkable="false"
                    android:clickable="false"
                    android:text="Pending"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="@color/m3_status_success_background" />

                <!-- ══════════════════════════════════════════════
                     ISSUE 3 FIX — Polished horizontal stepper
                     Each step = [node (circle)] + [label below]
                     Connected by horizontal lines.
                     Uses drawables instead of Unicode symbols.
                ═══════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/transaction_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Transaction progress"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Step nodes + connectors row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Step 0: Created — node -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/tv_timeline_created"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_timeline_node_complete" />

                                <TextView
                                    android:id="@+id/tv_timeline_created_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="5dp"
                                    android:ellipsize="none"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:text="Created"
                                    android:textColor="@color/m3_success"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Connector 1 -->
                            <View
                                android:id="@+id/timeline_connector_1"
                                android:layout_width="0dp"
                                android:layout_height="2dp"
                                android:layout_marginBottom="20dp"
                                android:layout_weight="0.6"
                                android:background="@color/m3_success" />

                            <!-- Step 1: QR Ready -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/tv_timeline_qr"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_timeline_node_upcoming" />

                                <TextView
                                    android:id="@+id/tv_timeline_qr_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="5dp"
                                    android:ellipsize="none"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:text="QR Ready"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Connector 2 -->
                            <View
                                android:id="@+id/timeline_connector_2"
                                android:layout_width="0dp"
                                android:layout_height="2dp"
                                android:layout_marginBottom="20dp"
                                android:layout_weight="0.6"
                                android:background="?attr/colorOutline" />

                            <!-- Step 2: Verified -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/tv_timeline_verified"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_timeline_node_upcoming" />

                                <TextView
                                    android:id="@+id/tv_timeline_verified_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="5dp"
                                    android:ellipsize="none"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:text="Verified"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Connector 3 -->
                            <View
                                android:id="@+id/timeline_connector_3"
                                android:layout_width="0dp"
                                android:layout_height="2dp"
                                android:layout_marginBottom="20dp"
                                android:layout_weight="0.6"
                                android:background="?attr/colorOutline" />

                            <!-- Step 3: Transfer -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/tv_timeline_transfer"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_timeline_node_upcoming" />

                                <TextView
                                    android:id="@+id/tv_timeline_transfer_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="5dp"
                                    android:ellipsize="none"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:text="Transfer"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Connector 4 -->
                            <View
                                android:id="@+id/timeline_connector_4"
                                android:layout_width="0dp"
                                android:layout_height="2dp"
                                android:layout_marginBottom="20dp"
                                android:layout_weight="0.6"
                                android:background="?attr/colorOutline" />

                            <!-- Step 4: Completed -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <View
                                    android:id="@+id/tv_timeline_completed"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_timeline_node_upcoming" />

                                <TextView
                                    android:id="@+id/tv_timeline_completed_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="5dp"
                                    android:ellipsize="none"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:text="Done"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="10sp" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Status summary below stepper -->
                        <TextView
                            android:id="@+id/tv_status_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="QR READY"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_status_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Waiting for verification"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── Transaction section header ── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Transaction"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Verification success banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/verification_success_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/m3_success"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_verification_success_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Verification successful"
                            android:text="✓"
                            android:textColor="@color/m3_success"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/transaction_verified"
                            android:textColor="@color/m3_success"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="QR successfully matched this transaction."
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── ISSUE 7 FIX: Transaction Code — single-line + ellipsis to prevent character wrapping ── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Transaction Code"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_transaction_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Reservation ID"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_reservation_id"
                    style="@style/TransactionDetailValue" />

                <!-- ── Energy and participants section ── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Energy and participants"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Prosumer"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_prosumer_id"
                    style="@style/TransactionDetailValue" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Microgrid Node ID"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_microgrid_node_id"
                    style="@style/TransactionDetailValue" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Energy Slot ID"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_energy_slot_id"
                    style="@style/TransactionDetailValue" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Energy Amount"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_energy_amount"
                    style="@style/TransactionDetailValue" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Status"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tv_status"
                    style="@style/TransactionDetailValue"
                    android:textColor="@color/m3_success" />

                <!-- QR action buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/generate_qr"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_qr"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/qr_generation_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_qr_generation_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/m3_error"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- ══════════════════════════════════════════════
                     ISSUE 8 FIX — Activity timestamps
                     Each entry is label (small secondary) + value
                     (normal primary) as separate TextViews for
                     proper visual hierarchy.
                ═══════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Activity times"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Created -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Created"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_created_at"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <!-- Updated -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Updated"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_updated_at"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <!-- Verified -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Verified"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_verification_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <!-- Energy Transfer -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Energy Transfer"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_energy_transfer_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <!-- ── Action area ── -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirm_energy_transfer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/continue_to_energy_transfer"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/scan_transaction_qr" />

                <TextView
                    android:id="@+id/tv_scan_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_verification_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/verification_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_verify_transaction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/verify_transaction" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel_verification"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cancel" />

                    <ProgressBar
                        android:id="@+id/verification_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/error_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
