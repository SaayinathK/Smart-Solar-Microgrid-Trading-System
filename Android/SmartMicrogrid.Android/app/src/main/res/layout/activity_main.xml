<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <ImageView android:layout_width="match_parent" android:layout_height="300dp" android:alpha="0.7" android:contentDescription="Smart energy network" android:scaleType="centerCrop" android:src="@drawable/bg_energy_home" app:layout_constraintTop_toTopOf="parent" />
    <View android:layout_width="match_parent" android:layout_height="300dp" android:background="#880F172A" app:layout_constraintTop_toTopOf="parent" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="SMART MICROGRID PORTAL" android:textColor="#BFDBFE" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" />
            <TextView android:id="@+id/tv_welcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Welcome, User!" android:textColor="@android:color/white" android:textSize="29sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Your command center for clean energy resources." android:textColor="#DBEAFE" android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMPONENT 1" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Energy resource workspace" android:textColor="?attr/colorOnSurface" android:textSize="19sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Explore infrastructure, discover clean energy and manage published supply." android:textColor="?android:attr/textColorSecondary" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="8dp" android:text="QUICK ACTIONS" android:textColor="?android:attr/textColorSecondary" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_microgrids" android:layout_width="match_parent" android:layout_height="58dp" android:icon="@android:drawable/ic_menu_compass" app:iconGravity="textStart" android:text="Explore solar microgrids" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_energy_availability" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:icon="@android:drawable/ic_menu_search" app:iconGravity="textStart" android:text="Find available energy" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_energy_slots" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:icon="@android:drawable/ic_menu_agenda" app:iconGravity="textStart" android:text="Browse energy slots" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_reservations" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:icon="@android:drawable/ic_menu_recent_history" app:iconGravity="textStart" android:text="Energy reservations &amp; trading" android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_profile" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:layout_marginBottom="20dp" android:icon="@android:drawable/ic_menu_myplaces" app:iconGravity="textStart" android:text="My profile" android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
