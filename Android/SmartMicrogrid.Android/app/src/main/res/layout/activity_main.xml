<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tv_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome, User!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Component 1 Mobile Telemetry Hub"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_microgrids"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="⚡ Solar Microgrid Nodes"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_energy_availability"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="☀️ Energy Availability"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_energy_slots"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="📊 Energy Slots Management"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_profile"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="My Profile"
        android:textAllCaps="false"
        android:textSize="16sp" />

</LinearLayout>
