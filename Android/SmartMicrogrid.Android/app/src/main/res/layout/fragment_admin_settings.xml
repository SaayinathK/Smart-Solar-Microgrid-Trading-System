<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_gutter">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/energy_workspace_label" android:textAppearance="@style/TextAppearance.Solar.Eyebrow"
            android:layout_marginBottom="6dp" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/workspace_settings_title" android:textColor="?android:attr/textColorPrimary"
            android:textSize="@dimen/screen_title_size" android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/m4_settings_caption"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/m4_platform_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/m4_platform_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:hint="@string/m4_platform_description">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/m4_platform_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:hint="@string/m4_session_timeout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/m4_session_timeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:hint="@string/m4_max_login_attempts">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/m4_max_login_attempts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:hint="@string/m4_default_page_size">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/m4_default_page_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/m4_maintenance_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/m4_maintenance_mode" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:hint="@string/m4_maintenance_message">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/m4_maintenance_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/m4_allow_registration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/m4_allow_registration" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/m4_save_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/m4_save_details" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/m4_save_toggles"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/m4_save" />

        <TextView
            android:id="@+id/m4_config_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:alpha="0.75" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
