{
	"info": {
		"_postman_id": "8f3b6a9c-2d1e-45fa-98b7-6c3d4e5f6a7b",
		"name": "Smart Microgrid - User Management API",
		"description": "Complete Postman collection for testing the Smart Microgrid User Management REST API endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "createdUserId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User (Public Prosumer)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"Prosumer\",\n  \"lastName\": \"User\",\n  \"email\": \"prosumer@microgrid.com\",\n  \"phoneNumber\": \"+1234567890\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				},
				{
					"name": "Login (Store JWT Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('authToken', jsonData.data.token);",
									"    console.log('JWT Token set successfully');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@microgrid.com\",\n  \"password\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Change Password",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"NewPassword123!\",\n  \"confirmNewPassword\": \"NewPassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/change-password",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "change-password"]
						}
					}
				}
			]
		},
		{
			"name": "Current User (Profile)",
			"item": [
				{
					"name": "Get Current User Profile (/me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/users/me",
							"host": ["{{baseUrl}}"],
							"path": ["users", "me"]
						}
					}
				},
				{
					"name": "Update Current User Profile (/me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"ProsumerUpdated\",\n  \"lastName\": \"UserUpdated\",\n  \"phoneNumber\": \"+9876543210\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/me",
							"host": ["{{baseUrl}}"],
							"path": ["users", "me"]
						}
					}
				}
			]
		},
		{
			"name": "User Management (Admin Only)",
			"item": [
				{
					"name": "Get All Users (Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/users?search=&role=&activeOnly=",
							"host": ["{{baseUrl}}"],
							"path": ["users"],
							"query": [
								{ "key": "search", "value": "" },
								{ "key": "role", "value": "" },
								{ "key": "activeOnly", "value": "" }
							]
						}
					}
				},
				{
					"name": "Create User (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('createdUserId', jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"Operator\",\n  \"lastName\": \"One\",\n  \"email\": \"operator1@microgrid.com\",\n  \"phoneNumber\": \"+1122334455\",\n  \"password\": \"Operator123!\",\n  \"role\": \"MicrogridOperator\",\n  \"isActive\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": ["{{baseUrl}}"],
							"path": ["users"]
						}
					}
				},
				{
					"name": "Get User By ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/users/{{createdUserId}}",
							"host": ["{{baseUrl}}"],
							"path": ["users", "{{createdUserId}}"]
						}
					}
				},
				{
					"name": "Update User (Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"OperatorUpdated\",\n  \"lastName\": \"OneUpdated\",\n  \"phoneNumber\": \"+9988776655\",\n  \"role\": \"MicrogridOperator\",\n  \"isActive\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/{{createdUserId}}",
							"host": ["{{baseUrl}}"],
							"path": ["users", "{{createdUserId}}"]
						}
					}
				},
				{
					"name": "Activate / Deactivate User (Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"isActive\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/{{createdUserId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["users", "{{createdUserId}}", "status"]
						}
					}
				},
				{
					"name": "Change User Role (Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"TransactionVerifier\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/{{createdUserId}}/role",
							"host": ["{{baseUrl}}"],
							"path": ["users", "{{createdUserId}}", "role"]
						}
					}
				},
				{
					"name": "Delete User (Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
						},
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/users/{{createdUserId}}",
							"host": ["{{baseUrl}}"],
							"path": ["users", "{{createdUserId}}"]
						}
					}
				}
			]
		}
	]
}
